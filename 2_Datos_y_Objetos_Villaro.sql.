DELIMITER //

-- Función 1: Calcular Edad
CREATE FUNCTION fn_calcular_edad(f_nac DATE) RETURNS INT DETERMINISTIC 
BEGIN RETURN TIMESTAMPDIFF(YEAR, f_nac, CURDATE()); END //

-- Función 2: Obtener Nombre de OS
CREATE FUNCTION fn_get_os_nombre(id INT) RETURNS VARCHAR(100) DETERMINISTIC 
BEGIN 
    DECLARE n VARCHAR(100); SELECT nombre INTO n FROM obras_sociales WHERE id_obra_social = id; RETURN n; 
END //

-- SP 1: Nuevo Paciente
CREATE PROCEDURE sp_nuevo_paciente(IN n VARCHAR(100), IN a VARCHAR(100), IN d VARCHAR(15), IN f DATE, IN o INT) 
BEGIN INSERT INTO pacientes (nombre, apellido, dni, fecha_nacimiento, id_obra_social) VALUES (n, a, d, f, o); END //

-- SP 2: Reponer Stock
CREATE PROCEDURE sp_reponer_stock(IN id INT, IN c INT) 
BEGIN UPDATE insumos SET stock = stock + c WHERE id_insumo = id; END //

-- Trigger 1: Auditoría de Inserción
CREATE TRIGGER tr_audit_pacientes_insert AFTER INSERT ON pacientes FOR EACH ROW 
BEGIN INSERT INTO log_auditoria (nombre_tabla, tipo_accion, usuario_accion) VALUES ('pacientes', 'INSERT', USER()); END //

-- Trigger 2: Auditoría de Password (Sugerencia de Leonel)
CREATE TRIGGER tr_audit_usuarios_pass_update BEFORE UPDATE ON usuarios_sistema FOR EACH ROW 
BEGIN IF OLD.password <> NEW.password THEN INSERT INTO log_auditoria (nombre_tabla, tipo_accion, usuario_accion) VALUES ('usuarios_sistema', 'UPDATE_PASS', USER()); END IF; END //

DELIMITER ;
