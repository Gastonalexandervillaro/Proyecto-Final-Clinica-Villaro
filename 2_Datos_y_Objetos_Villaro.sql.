-- 5. TRIGGERS (2 SOLICITADAS)
-- ==========================================

DELIMITER //
CREATE TRIGGER tr_audit_pacientes_insert AFTER INSERT ON pacientes FOR EACH ROW
BEGIN INSERT INTO log_auditoria (nombre_tabla, tipo_accion, usuario_accion) VALUES ('pacientes', 'INSERT', USER()); END //

CREATE TRIGGER tr_audit_usuarios_pass_update BEFORE UPDATE ON usuarios_sistema FOR EACH ROW
BEGIN IF OLD.password <> NEW.password THEN INSERT INTO log_auditoria (nombre_tabla, tipo_accion, usuario_accion) VALUES ('usuarios_sistema', 'UPDATE_PASS', USER()); END IF; END //
DELIMITER ;
