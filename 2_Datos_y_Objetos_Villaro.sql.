-- ==========================================
-- 2. VISTAS (5 SOLICITADAS)
-- ==========================================

CREATE OR REPLACE VIEW v_turnos_pendientes AS
SELECT t.id_turno, t.fecha_turno, p.apellido AS paciente, m.apellido AS medico
FROM turnos t JOIN pacientes p ON t.id_paciente = p.id_paciente
JOIN medicos m ON t.id_medico = m.id_medico WHERE t.estado = 'Pendiente';

CREATE OR REPLACE VIEW v_demanda_especialidades AS
SELECT e.nombre AS especialidad, COUNT(t.id_turno) AS total_turnos
FROM especialidades e LEFT JOIN medicos m ON e.id_especialidad = m.id_especialidad
LEFT JOIN turnos t ON m.id_medico = t.id_medico GROUP BY e.nombre;

CREATE OR REPLACE VIEW v_stock_insumos_criticos AS
SELECT nombre, stock FROM insumos WHERE stock < 10;

CREATE OR REPLACE VIEW v_facturacion_por_os AS
SELECT os.nombre, SUM(fc.monto_total) AS total_recaudado
FROM obras_sociales os JOIN pacientes p ON os.id_obra_social = p.id_obra_social
JOIN facturas_cabecera fc ON p.id_paciente = fc.id_paciente GROUP BY os.nombre;

CREATE OR REPLACE VIEW v_profesionales_salas AS
SELECT DISTINCT m.apellido, e.nombre AS especialidad, c.numero_sala
FROM medicos m JOIN especialidades e ON m.id_especialidad = e.id_especialidad
JOIN turnos t ON m.id_medico = t.id_medico
JOIN consultorios c ON t.id_consultorio = c.id_consultorio;

-- ==========================================
-- 3. FUNCIONES (2 SOLICITADAS)
-- ==========================================

DELIMITER //
CREATE FUNCTION fn_calcular_edad(fecha_nac DATE) RETURNS INT DETERMINISTIC
BEGIN RETURN TIMESTAMPDIFF(YEAR, fecha_nac, CURDATE()); END //

CREATE FUNCTION fn_get_os_nombre(id_os INT) RETURNS VARCHAR(100) DETERMINISTIC
BEGIN 
    DECLARE v_nombre VARCHAR(100);
    SELECT nombre INTO v_nombre FROM obras_sociales WHERE id_obra_social = id_os;
    RETURN v_nombre; 
END //
DELIMITER ;

-- ==========================================
-- 4. PROCEDIMIENTOS (2 SOLICITADAS)
-- ==========================================

DELIMITER //
CREATE PROCEDURE sp_nuevo_paciente(IN p_nom VARCHAR(100), IN p_ape VARCHAR(100), IN p_dni VARCHAR(15), IN p_f DATE, IN p_os INT)
BEGIN INSERT INTO pacientes (nombre, apellido, dni, fecha_nacimiento, id_obra_social) VALUES (p_nom, p_ape, p_dni, p_f, p_os); END //

CREATE PROCEDURE sp_reponer_stock(IN p_id INT, IN p_cant INT)
BEGIN UPDATE insumos SET stock = stock + p_cant WHERE id_insumo = p_id; END //
DELIMITER ;

